{
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],
    "files.associations": {
        "*.cclist": "cclist",
    },
    "[json]":{
        "editor.rulers": [120]
    },
    "[toml]":{
        "editor.rulers": [120]
    },
    "[txt]": {
        "editor.rulers": [
            { "column": 0,  "color": "#444444" },
            { "column": 5,  "color": "#666666" },
            { "column": 10, "color": "#888888" },
            { "column": 15, "color": "#aaaaaa" },
            { "column": 16, "color": "#333333" },
            { "column": 20, "color": "#cccccc" },
            { "column": 21, "color": "#333333" }
        ],
        "editor.fontSize": 18,
        "editor.lineNumbers": "off",
    },
    "[python]": {
        "editor.rulers": [120],
        "editor.fontSize": 12,
        "editor.lineNumbers": "on",
    },
}